@backend = http://localhost:3000
@testEmail = test@example.com
@testPassword = password123

### Check backend

GET {{backend}}/health

### Create user
# @name createUser

POST {{backend}}/signup
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Make login
# @name login

POST {{backend}}/users/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Get authenticated user

GET {{backend}}/auth/me

### Logout

POST {{backend}}/auth/logout

### Get how to play 

GET {{backend}}/how-to-play/scar

### Get how to play in spanish

GET {{backend}}/how-to-play/scar?lang=es

### Get villains

GET {{backend}}/villains

### Get villains in spanish

GET {{backend}}/villains?lang=es

### Get villain by id

GET {{backend}}/villains/scar

### Get villain by id in spanish

GET {{backend}}/villains/scar?lang=es

### Path traversal test: plain relative path
# This client or the server may normalize the URL before it reaches the route.

GET {{backend}}/villains/../translations/actions

### Path traversal test: encoded slashes
# A safe implementation should reject this identifier and return 404 or 400.

GET {{backend}}/villains/..%2Ftranslations%2Factions

