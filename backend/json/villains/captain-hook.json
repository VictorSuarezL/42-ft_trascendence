  "source": {
    "article": "https://disney-villainous.fandom.com/wiki/Captain_Hook",
    "sourceLanguage": "en"
  },
  "translations": {
    "en": {
      "objective": "Captain Hook must defeat Peter Pan at the Jolly Roger.",
      "locations": {
        "jolly-roger": "Jolly Roger",
        "skull-rock": "Skull Rock",
        "mermaid-lagoon": "Mermaid Lagoon",
        "hangman-s-tree": "Hangman's Tree"
      },
      "cards": {
        "boarding-party": {
          "name": "Boarding Party",
          "text": "When performing a Vanquish action, Boarding Party may be used to defeat a Hero at their location or at an adjacent unlocked location."
        },
        "give-them-a-scare": {
          "name": "Give Them a Scare",
          "text": "Look at the top two cards of your Fate deck. Either discard both cards or return them to the top in any order."
        },
        "swashbuckler": {
          "name": "Swashbuckler",
          "text": "No additional Ability."
        },
        "worthy-opponent": {
          "name": "Worthy Opponent",
          "text": "Gain 2 Power. Reveal cards from the top of your Fate deck until you reveal a Hero. Play that Hero and discard the rest."
        },
        "aye-aye-sir": {
          "name": "Aye, Aye, Sir!",
          "text": "Move an Ally to an adjacent unlocked location. That Ally gets +2 Strength until the end of your turn."
        },
        "cannon": {
          "name": "Cannon",
          "text": "This location gains: Vanquish action."
        },
        "cunning": {
          "name": "Cunning",
          "text": "During their turn, if another player has an Ally with a Strength of 4 or more in their realm, you may play Cunning. Play an Ally from your hand for free."
        },
        "cutlass": {
          "name": "Cutlass",
          "text": "When Cutlass is played, attach it to an Ally. That Ally gets +2 Strength."
        },
        "hook-s-case": {
          "name": "Hook's Case",
          "text": "This location gains: Gain 1 Power action."
        },
        "obsession": {
          "name": "Obsession",
          "text": "During their turn, if another player defeats a Hero with a Strength of 4 or more, you may play Obsession. Reveal cards from the top of your Fate deck until you reveal a Hero. Either play or discard the Hero. Discard the rest."
        },
        "pirate-brute": {
          "name": "Pirate Brute",
          "text": "No additional Ability."
        },
        "ingenious-device": {
          "name": "Ingenious Device",
          "text": "This location gains: Move a Hero action."
        },
        "mr-starkey": {
          "name": "Mr. Starkey",
          "text": "When Mr. Starkey is played, you may move a Hero from his location to an adjacent unlocked location."
        },
        "never-land-map": {
          "name": "Never Land Map",
          "text": "When Never Land Map is played, unlock Hangman's Tree.When you play an Item, you may discard Never Land Map instead of paying the Item's cost."
        },
        "smee": {
          "name": "Smee",
          "text": "Smee gets +2 Strength if he is at the Jolly Roger."
        },
        "pixie-dust": {
          "name": "Pixie Dust",
          "text": "When Pixie Dust is played, attach it to a Hero. That Hero gets +2 Strength."
        },
        "lost-boys": {
          "name": "Lost Boys",
          "text": "When performing a Vanquish action to defeat Lost Boys, at least two Allies must be used."
        },
        "splitting-headache": {
          "name": "Splitting Headache",
