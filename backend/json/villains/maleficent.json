  "source": {
    "article": "https://disney-villainous.fandom.com/wiki/Maleficent",
    "sourceLanguage": "en"
  },
  "translations": {
    "en": {
      "name": "Maleficent",
      "objective": "Maleficent must play Curses and move them as needed so she has at least one Curse at each location in her realm. She can only win at the start of her turn.",
      "locations": {
        "forbidden-mountains": "Forbidden Mountains",
        "briar-rose-s-cottage": "Briar Rose's Cottage",
        "the-forest": "The Forest",
        "king-stefan-s-castle": "King Stefan's Castle"
      },
      "cards": {
        "cackling-goon": {
          "name": "Cackling Goon",
          "text": "Cackling Goon gets +1 Strength for each Hero at his location."
        },
        "dragon-form": {
          "name": "Dragon Form",
          "text": "Defeat a Hero with a Strength of 3 or less. If a Fate action targets you before your next turn, gain 3 Power."
        },
        "forest-of-thorns": {
          "name": "Forest of Thorns",
          "text": "Heroes must have a Strength of 4 or more to be played to this location.Discard this Curse when a Hero is played to this location."
        },
        "green-fire": {
          "name": "Green Fire",
          "text": "Heroes cannot be played to this location.Discard this Curse if Maleficent moves to this location."
        },
        "savage-goon": {
          "name": "Savage Goon",
          "text": "No additional Ability."
        },
        "sinister-goon": {
          "name": "Sinister Goon",
          "text": "Sinister Goon gets +1 Strength if there are any Curses at his location."
        },
        "vanish": {
          "name": "Vanish",
          "text": "At the start of your next turn, Maleficent does not have to move to a new location."
        },
        "dreamless-sleep": {
          "name": "Dreamless Sleep",
          "text": "Heroes at this location get -2 Strength.Discard this Curse when an Ally is played to this location."
        },
        "malice": {
          "name": "Malice",
          "text": "During their turn, if another player defeats a Hero with a Strength of 4 or more, you may play Malice. Defeat a Hero with a Strength of 4 or less."
        },
        "tyranny": {
          "name": "Tyranny",
          "text": "During their turn, if another player has three or more Allies in their Realm, you may play Tyranny. Draw three cards into your hand, then discard any three cards."
        },
        "raven": {
          "name": "Raven",
          "text": "Before Maleficent moves, you may move Raven to any location and perform one available action at his new location. Raven cannot perform Fate actions."
        },
        "spinning-wheel": {
          "name": "Spinning Wheel",
          "text": "If a Hero is defeated at this location, gain Power equal to the Hero's Strength minus 1."
        },
        "staff": {
          "name": "Staff",
          "text": "If Maleficent is at this location, the Cost to play an Effect or Curse is reduced by 1 Power."
        },
        "guards-maleficent": {
          "name": "Guards (Maleficent)",
          "text": "When performing a Vanquish action to defeat Guards, at least two Allies must be used."
        },
        "sword-of-truth": {
          "name": "Sword of Truth",
          "text": "When Sword of Truth is played, attach it to a Hero with no other attached Items. That Hero gets +2 Strength. The Cost to play a Curse to this location is increased by 2 Power."
        },
        "once-upon-a-dream": {
          "name": "Once Upon a Dream",
          "text": "Discard a Curse from a location in Maleficent's Realm that has a Hero."
        },
        "aurora": {
          "name": "Aurora",
          "text": "When Aurora is played, reveal the top card of Maleficent's Fate deck. If it is a Hero, play it. Otherwise, return it to the top of the deck."
        },
        "fauna": {
          "name": "Fauna",
          "text": "When Fauna is played, you may discard Dreamless Sleep from her location."
        },
        "flora": {
          "name": "Flora",
          "text": "When Flora is played, Maleficent must reveal her hand.Until Flora is defeated, Maleficent must play with her hand revealed."
        },
        "king-hubert": {
          "name": "King Hubert",
          "text": "When King Hubert is played, you may move one Ally from each adjacent location to his location."
        },
        "king-stefan": {
          "name": "King Stefan",
          "text": "When King Stefan is played, you may move Maleficent to any location."
        },
        "merryweather": {
          "name": "Merryweather",
          "text": "Curses cannot be played to Merryweather's location."
        },
        "prince-phillip": {
          "name": "Prince Phillip",
          "text": "When Prince Phillip is played, you may discard all Allies from his location."
        }
      }
