  "source": {
    "article": "https://disney-villainous.fandom.com/wiki/Scar",
    "sourceLanguage": "en"
  },
  "translations": {
    "en": {
      "objective": "Scar must find and defeat Mufasa, and then defeat other Heroes in order to have at least 15 Strength in the Succession pile. He can only win at the start of his turn.",
      "locations": {
        "pride-rock": "Pride Rock",
        "the-savanna": "The Savanna",
        "elephant-graveyard": "Elephant Graveyard",
        "the-gorge": "The Gorge"
      },
      "cards": {
        "hungry-hyena": {
          "name": "Hungry Hyena",
          "text": "Hungry Hyena gets +1 Strength for each other Hyena at her location."
        },
        "long-live-the-king": {
          "name": "Long Live the King",
          "text": "Reveal the top four cards of your Fate deck. You may play one Hero. Discard the rest."
        },
        "be-prepared": {
          "name": "Be Prepared",
          "text": "Discard the top three cards of your deck. You may choose one Effect or up to two Allies from your discard pile and put them into your hand."
        },
        "stick-with-me": {
          "name": "Stick with Me",
          "text": "Choose a Hyena who is not at Scar's location. You may perform one available action at that Hyena's location. You cannot use Stick with Me to perform Fate actions."
        },
        "whisper": {
          "name": "Whisper",
          "text": "Choose a card from your Fate discard pile and play it."
        },
        "feeding-frenzy": {
          "name": "Feeding Frenzy",
          "text": "Choose a location and move any number of Hyenas in your Realm to that location."
        },
        "injustice": {
          "name": "Injustice",
          "text": "During their turn, if another player targets you with a Fate action, you may play Injustice. Before they reveal cards, look at the top two cards of your Fate deck. Either discard or return each to the top of the deck."
        },
        "pride": {
          "name": "Pride",
          "text": "During their turn, if another player discards two or more cards, you may play Pride. Gain 3 Power."
        },
        "stampede": {
          "name": "Stampede",
          "text": "If Stampede is played to a location that has a Hero, move one Hero at that location to an adjacent location. Then you may perform a Vanquish action at the Hero's new location."
        },
        "banzai-the-hyena": {
          "name": "Banzai the Hyena",
          "text": "Gain 1 Power for each other Hyena discarded from Banzai's location."
        },
        "ed-the-hyena": {
          "name": "Ed the Hyena",
          "text": "The Cost to play Hyenas to Ed's location is reduced by 1 Power."
        },
        "shenzi-the-hyena": {
          "name": "Shenzi the Hyena",
          "text": "When Shenzi is played, you may play a Hyena from your hand for free."
        },
        "hakuna-matata": {
          "name": "Hakuna Matata",
          "text": "Either choose a Hero with a Strength of 3 or less from the Succession pile and play that Hero, or move a Hero to any location."
        },
        "prophecy": {
          "name": "Prophecy",
          "text": "When Prophecy is played, attach it to a Hero with no other attached Items. That Hero gets +3 Strength."
        },
        "mufasa": {
          "name": "Mufasa",
          "text": "When Mufasa is defeated, put him into the Succession pile. If Mufasa is in the Succession pile, all Heroes you defeat are put into the Succession pile."
        },
        "nala": {
          "name": "Nala",
          "text": "When Nala is played, you may move a Hero to any location."
        },
        "pumbaa": {
          "name": "Pumbaa",
          "text": "Pumbaa gets +2 Strength if Timon is in Scar's Realm."
        },
        "rafiki": {
          "name": "Rafiki",
          "text": "Scar must defeat Rafiki before defeating other Heroes."
        },
        "rafiki-s-stick": {
          "name": "Rafiki's Stick",
          "text": "When Rafiki's Stick is played, attach it to a Hero. When that Hero would be defeated, discard this Item instead."
        },
        "sarabi": {
          "name": "Sarabi",
          "text": "When Sarabi is played, you may discard a Hyena from her location."
        },
        "simba": {
          "name": "Simba",
          "text": "Hyenas cannot have a Strength of more than 2."
        },
        "timon": {
          "name": "Timon",
          "text": "Timon gets +2 Strength if Pumbaa is in Scar's Realm."
        },
        "zazu": {
          "name": "Zazu",
          "text": "All other Heroes at Zazu's location get -2 Strength. All Heroes at other locations get +1 Strength."
        }
      }
    },
    "es": {
      "objective": "Scar debe encontrar y derrotar a Mufasa y, después, derrotar a otros Héroes hasta tener al menos 15 de Fuerza en la pila de Sucesión. Solo puede ganar al comienzo de su turno.",
      "locations": {
        "pride-rock": "Roca del Rey",
        "the-savanna": "La Sabana",
        "elephant-graveyard": "Cementerio de Elefantes",
        "the-gorge": "El Desfiladero"
      },
      "cards": {
